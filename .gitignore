# ============================================================
# AgriAI .gitignore
# ============================================================

# --- Python & Virtual Environments ---
backend/venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Node & Frontend Dependencies & Builds ---
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.vite/
.vite-temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local SQLite Database & Runtime Data ---
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
*.db
*.sqlite
*.sqlite3
!backend/data/.gitkeep

# --- Environment Variables & Local Secrets ---
.env
.env.local
.env.*.local
*.env

# --- IDE & OS Temporary Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini

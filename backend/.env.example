# ============================================================
# AgriAI Backend Environment Configuration Template
# ============================================================
# Copy this file to .env and configure values before starting the backend.

# Directorate of Marketing & Inspection (DMI) Agmarknet / data.gov.in API Key
# Required only for online daily synchronization from official government portal.
# Register and request API key at https://data.gov.in/
DATA_GOV_IN_API_KEY=your_api_key_here

# Daily Mandi Price Collection Scheduler Configuration
MANDI_SCHEDULER_ENABLED=true
MANDI_SYNC_SCHEDULE_TIME=18:30
MANDI_SYNC_TIMEZONE=Asia/Kolkata

# Local AI Chatbot Inference Engine (LM Studio)
LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
LM_STUDIO_MODEL=phi-3-mini-4k-instruct
LM_STUDIO_TIMEOUT=15

# Access Control (comma-separated usernames with administrative privileges)
ADMIN_USERS=admin,yashas

# Production CORS Allowed Origins (comma-separated URLs; leave empty for local development)
# ALLOWED_ORIGINS=https://agriai.example.com
